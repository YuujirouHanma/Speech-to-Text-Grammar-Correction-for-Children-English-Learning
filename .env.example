# Copy to .env and adjust. Every setting can also be passed as an environment variable.
# Full list: src/speech_grammar/config.py (prefix SPEECH_GRAMMAR_).

# --- Security -----------------------------------------------------------------
# Comma-separated API keys; empty = no authentication (only acceptable on localhost).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPEECH_GRAMMAR_API_KEYS=
# Browser origins allowed to call the API (comma-separated), e.g. https://app.example.org
SPEECH_GRAMMAR_CORS_ORIGINS=
# Per API key or client IP. A class on one Wi-Fi shares one IP: the public demo uses 600.
SPEECH_GRAMMAR_RATE_LIMIT_PER_MINUTE=60
# Reverse proxy addresses allowed to set X-Forwarded-For
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Privacy (children's data) ------------------------------------------------
# Keep true: clients must send consent=true (verifiable parental consent obtained by the app).
SPEECH_GRAMMAR_REQUIRE_CONSENT=true
SPEECH_GRAMMAR_JOB_TTL_SECONDS=600
SPEECH_GRAMMAR_JOB_DELETE_AFTER_READ=false
# Cloud STT sends children's voices to a third party. Leave false unless a DPA is in place.
# Never enable Gemini for children: the Gemini API terms forbid services directed at, or likely
# used by, under-18s (adult-voice experiments only).
SPEECH_GRAMMAR_ALLOW_CLOUD_STT=false
SPEECH_GRAMMAR_GEMINI_API_KEY=
SPEECH_GRAMMAR_DEEPGRAM_API_KEY=

# --- Models -------------------------------------------------------------------
SPEECH_GRAMMAR_MODELS_DIR=models
# t5-gec-v2 = retrained model (default); t5-gec = original saved_model
SPEECH_GRAMMAR_T5_MODEL_NAME=t5-gec-v2
SPEECH_GRAMMAR_DEVICE=auto
SPEECH_GRAMMAR_CORRECTOR_BACKEND=ctranslate2
# "none" disables the fallback (the Docker image has no PyTorch)
SPEECH_GRAMMAR_CORRECTOR_FALLBACK_BACKEND=torch
# auto = small.en on GPU (best and stable in the STT evaluation), base.en on CPU (3-6x faster,
# accuracy overlaps with small.en).
SPEECH_GRAMMAR_WHISPER_MODEL=auto
SPEECH_GRAMMAR_WHISPER_VERBATIM_PROMPT=true
SPEECH_GRAMMAR_AUDIO_DENOISE=false

# --- Feedback -----------------------------------------------------------------
# Show a correction only if the model clearly prefers it (calibrated: 2.5;
# 1.0 = more suggestions but more wrong ones; -inf = off).
SPEECH_GRAMMAR_MIN_CORRECTION_MARGIN=2.5
# Punctuation/capitalization feedback for typed text (speech transcripts never get it).
SPEECH_GRAMMAR_PUNCTUATION_FEEDBACK=true
# Language of the error descriptions: id or en.
SPEECH_GRAMMAR_FEEDBACK_LANGUAGE=id
# Public demo: the UI asks for adult voices only.
SPEECH_GRAMMAR_DEMO_MODE=false

# --- Capacity -----------------------------------------------------------------
# 2 on a GPU (README, load test), 1 on a CPU.
SPEECH_GRAMMAR_INFERENCE_WORKERS=1
# Requests beyond this get a 503. The public demo uses 32: a whole class may press at once.
SPEECH_GRAMMAR_MAX_PENDING_REQUESTS=16
SPEECH_GRAMMAR_MAX_UPLOAD_MB=10
SPEECH_GRAMMAR_MAX_AUDIO_SECONDS=60
# Serverless hosts (Vercel): load the models during the first request, not in the background.
SPEECH_GRAMMAR_LOAD_MODELS_ON_DEMAND=false

# --- Monitoring stack (docker compose --profile monitoring) ----------------------
GRAFANA_ADMIN_PASSWORD=
